# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun. .env asla commit edilmez.

# --- Supabase (PostgreSQL) ---
# Yönetici bağlantısı: yalnızca migration/seed/test scriptleri kullanır, n8n KULLANMAZ.
# Supabase Dashboard > Connect > "Session pooler" URI (IPv4 uyumlu, port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# n8n'in bağlandığı kısıtlı veritabanı rolü (health_app) için parola.
# db:migrate bu parolayı role atar; rol yalnızca health şemasındaki API fonksiyonlarını çalıştırabilir.
APP_DB_PASSWORD=<uzun-rastgele-parola>

# --- n8n ---
N8N_BASE_URL=http://localhost:5678
# n8n > Settings > n8n API > Create an API key
N8N_API_KEY=<n8n-api-key>
# n8n'de mevcut Google Gemini (PaLM) API credential'ının ID'si (credential URL'sinde görünür)
N8N_GEMINI_CREDENTIAL_ID=<gemini-credential-id>
# n8n:push ilk çalıştırmada workflow'u oluşturur ve ID'yi yazdırır; sonraki push'lar için buraya ekleyin.
N8N_WORKFLOW_ID=

# --- Uygulama ---
GEMINI_MODEL=models/gemini-3-flash-preview
# Opsiyonel: ana model 503/429 verirse kullanılacak yedek model (boş bırakılabilir)
GEMINI_FALLBACK_MODEL=models/gemini-3.8-flash
# v2: niyet/duygu router'ı için hızlı model (Faz 0 ölçümü: 6/6 doğru, ~1 sn)
GEMINI_ROUTER_MODEL=models/gemini-3.5-flash-lite
# Webhook CORS izinli origin listesi (virgülle ayrılmış)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
