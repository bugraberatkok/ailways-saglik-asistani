{
  "name": "ailways-saglik-asistani",
  "version": "0.1.0",
  "private": true,
  "description": "n8n + Supabase + Gemini tabanlı yapay zeka sağlık asistanı (staj projesi)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:workflow",
    "build:css": "tailwindcss -i frontend/src/styles.css -o frontend/dist/styles.css --minify",
    "build:workflow": "node scripts/build-workflow.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "n8n:push": "node scripts/n8n-push.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:db": "node --test --test-concurrency=1 \"tests/db/**/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.mjs\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "pg": "^8.13.0",
    "tailwindcss": "^4.1.0"
  }
}
